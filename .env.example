# Optional automation API key. Defaults to admin-key when omitted.
ADMIN_API_KEY=admin-key
# Browser Admin UI password. Defaults to admin-key when omitted; production should override this
# with JANUA_ADMIN_PASSWORD or config/agent-config.json admin.password.
# JANUA_ADMIN_PASSWORD=replace-me-with-a-long-random-password
# JANUA_ADMIN_PASSWORD_HASH=scrypt:...
JANUA_DATA_DIR=data
JANUA_DB_PATH=data/janua.db
JANUA_CONFIG_DIR=config
JANUA_PORT=3000
JANUA_PUBLIC_BASE_URL=http://localhost:3000
JANUA_ALLOWED_ORIGINS=http://localhost:3000
JANUA_RATE_LIMIT_ENABLED=true
JANUA_RATE_LIMIT_WINDOW_MS=60000
JANUA_RATE_LIMIT_MAX=60
JANUA_ADMIN_RATE_LIMIT_MAX=120
JANUA_RATE_LIMIT_MAX_BUCKETS=10000
JANUA_TRUST_PROXY=false
JANUA_SECURITY_HEADERS_ENABLED=true
JANUA_CONVERSATION_CLEANUP_ENABLED=true
JANUA_CONVERSATION_CLEANUP_INTERVAL_MS=3600000
# JANUA_MIGRATIONS_DIR=packages/core/drizzle
# Product-internal agent config is read once during server startup. Copy config/agent-config.example.json to this path.
JANUA_AGENT_CONFIG_PATH=config/agent-config.json
# Fallbacks used only when JANUA_AGENT_CONFIG_PATH does not exist or omits a value.
LEAD_WEBHOOK_URL=
JANUA_LLM_PROVIDER=fake
JANUA_OLLAMA_PREWARM=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
